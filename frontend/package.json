{
  "name": "plega-frontend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src *.mjs index.html vite.config.ts package.json",
    "format:check": "prettier --check src *.mjs index.html vite.config.ts package.json",
    "test:browser": "node verify-origami.mjs && node verify-kinetic.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "lucide-react": "0.577.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
